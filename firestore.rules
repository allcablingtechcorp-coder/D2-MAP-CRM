rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function actorMembership(organizationId) {
      return get(/databases/$(database)/documents/organizations/$(organizationId)/memberships/$(request.auth.uid));
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && actorMembership(organizationId).data.status == "active";
    }

    function isActiveAdministrator(organizationId) {
      return isActiveMember(organizationId)
        && actorMembership(organizationId).data.role in ["owner", "operations_admin"];
    }

    match /organizations/{organizationId} {
      allow get: if isActiveMember(organizationId);
      allow list, create, update, delete: if false;

      match /memberships/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isActiveAdministrator(organizationId));
        allow list: if isActiveAdministrator(organizationId);
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isActiveAdministrator(organizationId);
        allow create, update, delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isActiveAdministrator(organizationId);
        allow create, update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
