rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function actorMembership(organizationId) {
      return get(/databases/$(database)/documents/organizations/$(organizationId)/memberships/$(request.auth.uid));
    }

    function companyGrant(organizationId) {
      return !(organizationId in ["d2-smart-home", "d2-hvac-solutions"]) || (actorMembership("d2-group").data.status == "active" && organizationId in actorMembership("d2-group").data.get("companyIds", []));
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && actorMembership(organizationId).data.status == "active" && companyGrant(organizationId);
    }

    function isActiveAdministrator(organizationId) {
      return isActiveMember(organizationId)
        && actorMembership(organizationId).data.role in ["owner", "operations_admin"]
        && "admin" in actorMembership(organizationId).data.modules;
    }

    function canReadGovernance(organizationId, permission) {
      return (organizationId != "d2-group" || actorMembership(organizationId).data.role == "owner") && isActiveAdministrator(organizationId)
        && actorMembership(organizationId).data.get("permissionOverrides", {}).get(permission, true) == true;
    }

    match /organizations/{organizationId} {
      allow get: if isActiveMember(organizationId);
      allow list, create, update, delete: if false;

      match /memberships/{uid} {
        allow get: if signedIn() && ((request.auth.uid == uid && companyGrant(organizationId)) || canReadGovernance(organizationId, "membership.read"));
        allow list: if canReadGovernance(organizationId, "membership.read");
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if canReadGovernance(organizationId, "membership.read");
        allow create, update, delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if canReadGovernance(organizationId, "audit.read");
        allow create, update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
